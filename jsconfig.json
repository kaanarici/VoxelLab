{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable", "webworker"],
    "noEmit": true,
    "strict": false
  },
  "include": ["js/**/*.js", "viewer.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "data", "dist", "build", ".vercel", "test-results"]
}
